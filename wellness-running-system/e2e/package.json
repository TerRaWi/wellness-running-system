{
  "name": "wellness-e2e",
  "private": true,
  "description": "ชุดทดสอบ Playwright ของหน้าแอดมินและหน้าพนักงาน (ใช้ฐานข้อมูลทดสอบบนเครื่องเท่านั้น)",
  "scripts": {
    "db:start": "node db/start-mysql.js",
    "db:seed": "node db/seed.js",
    "db:recreate": "node db/seed.js --recreate",
    "test": "playwright test --project=functional",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.6"
  }
}
